# =============================================================
#  Secrets — copie ce fichier en `.env` et remplis tes valeurs.
#  Le fichier `.env` est ignoré par git (voir .gitignore) : il ne
#  sera JAMAIS publié. Sur GitHub Actions, ces variables se mettent
#  dans Settings > Secrets and variables > Actions (voir README).
# =============================================================

# --- Compte Stych (celui avec lequel tu réserves tes créneaux) ---
STYCH_EMAIL=ton.email@example.com
STYCH_PASSWORD=ton_mot_de_passe_stych

# --- Bot Telegram ---
# Token donné par @BotFather (format 123456789:AA...)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Ton identifiant de chat, donné par @userinfobot (un nombre)
TELEGRAM_CHAT_ID=123456789
